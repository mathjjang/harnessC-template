{
  "_harnessC": "v0.1 — 손으로 작성. 이후 harness build가 .harness/HARNESS.md+팩에서 생성한다. 생성 구간은 손으로 고치지 않는다.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .harness/scripts/harness-status.mjs",
            "timeout": 10,
            "statusMessage": "하네스 세션 카드"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .harness/scripts/check-session-log.mjs",
            "timeout": 10,
            "statusMessage": "세션 로그 확인"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/mobile-mode.mjs",
            "timeout": 5,
            "statusMessage": "모바일 모드 판정 (Remote Control 연결 시)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-scratch.mjs",
            "timeout": 10,
            "statusMessage": "임시 파일 자리 검사"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/guard-reference.mjs",
            "timeout": 10,
            "statusMessage": "참조 저장소 쓰기 검사"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-scratch.mjs",
            "timeout": 10,
            "statusMessage": "임시 파일 자리 검사"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/guard-reference.mjs",
            "timeout": 10,
            "statusMessage": "참조 저장소 쓰기 검사 (셸 리다이렉션)"
          }
        ]
      }
    ]
  }
}
